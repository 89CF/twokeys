# TwoKeys app configuration (copy to .env.local). All values are devnet-only.

# Solana RPC endpoint
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Deployed TwoKeys program id (from `anchor deploy`). Leave empty to use the SDK default.
NEXT_PUBLIC_PROGRAM_ID=

# Test USDC mint (6 decimals) created by scripts/ on devnet
NEXT_PUBLIC_USDC_MINT=

# Default arbiter wallet suggested in the offer form (leave empty = no arbiter, disputes disabled)
NEXT_PUBLIC_ARBITER=

# Platform identities used for anonymous on-chain stats (any pubkey; one per demo marketplace)
NEXT_PUBLIC_PLATFORM_AUTO=
NEXT_PUBLIC_PLATFORM_RENT=

# Server only: mint authority of the test USDC mint, as a JSON byte array (e.g. contents of keys/mint-authority.json).
# Used by POST /api/faucet. Never expose this on mainnet.
FAUCET_SECRET_KEY=
